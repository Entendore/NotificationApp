<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ============ LOCAL NOTIFICATIONS ============ -->
        <Button
            android:id="@+id/btnImmediate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Local Notification" />

        <Button
            android:id="@+id/btnScheduled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Schedule Notification (10 sec)" />

        <!-- ============ REMINDERS ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="📅 Reminders"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="➕ Create Reminder" />

        <Button
            android:id="@+id/btnOpenCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Open Google Calendar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F1F1F1"
            android:gravity="center"
            android:padding="16dp"
            android:text="Nothing scheduled 🎉"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClearAlarms"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear local reminders" />

        <!-- ============ RICH STYLES ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="🎨 Notification Styles"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBigText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Big Text Style" />

        <Button
            android:id="@+id/btnBigPicture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Big Picture Style" />

        <Button
            android:id="@+id/btnInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inbox Style (list)" />

        <Button
            android:id="@+id/btnMessaging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messaging Style (chat)" />

        <Button
            android:id="@+id/btnProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress Bar" />

        <!-- ============ EMAIL ============ -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Recipient email address"
            android:inputType="textEmailAddress" />

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send Email Notification" />

    </LinearLayout>
</ScrollView>
